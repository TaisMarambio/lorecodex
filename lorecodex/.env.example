############################################
# Example `.env` for local development
# - Copy to `.env` and fill values.
# - Never commit `.env` with real secrets.
############################################

# App
APP_PORT=8081
SECURITY_AUTH_PROVIDER=auth0

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Database
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=lorecodex_db
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me

# Auth0 (Resource Server / API)
AUTH0_DOMAIN=dev-yourtenant.us.auth0.com
AUTH0_AUDIENCE=https://api.yourapp.com

# Optional overrides (usually not needed)
# AUTH0_ISSUER_URI=https://dev-yourtenant.us.auth0.com/
# AUTH0_JWKS_URI=https://dev-yourtenant.us.auth0.com/.well-known/jwks.json

# Claims mapping (optional; claim names can be comma-separated)
AUTH0_PRINCIPAL_CLAIM=sub
# Common Auth0 patterns:
# - roles
# - https://api.yourapp.com/roles (namespaced custom claim)
AUTH0_ROLES_CLAIM=roles
AUTH0_PERMISSIONS_CLAIM=permissions
AUTH0_EMAIL_CLAIM=email
AUTH0_AUTO_PROVISION_USER=true

# Local JWT (only if SECURITY_AUTH_PROVIDER=local)
TOKEN_SIGNING_KEY=

# IGDB / Twitch
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# Mailtrap
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
